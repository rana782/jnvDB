{
  "name": "@jnv/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "fixture:pdf": "node scripts/generate-report-card-test-pdf.mjs",
    "fixture:pdfs:extra": "node scripts/generate-report-card-fixtures-extra.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push && prisma db seed",
    "db:studio": "prisma studio",
    "import:run": "tsx src/scripts/run-import.ts",
    "import:run:ocr": "tsx src/scripts/run-import-ocr.ts",
    "import:bulk": "tsx src/scripts/run-import.ts",
    "verify:api-all": "tsx scripts/verify-imported-schools-api.ts",
    "verify:pdf-db": "tsx scripts/verify-pdf-db-consistency.ts",
    "verify:report": "tsx scripts/generate-release-report.ts",
    "dev:promote-partial": "tsx scripts/dev-promote-partial-schools.ts",
    "dev:reconcile-dashboard": "tsx scripts/dev-reconcile-dashboard-data.ts",
    "dev:fix-school-names": "tsx scripts/dev-fix-school-names-from-profile.ts",
    "dev:recompute-revenue": "tsx scripts/dev-recompute-revenue-scenarios.ts",
    "db:seed": "prisma db seed",
    "verify:golden-pdf": "node scripts/ensure-golden-pdf-for-verify.mjs",
    "verify:capture-api": "tsx scripts/capture-school-detail-response.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.3",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@prisma/client": "^6.3.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.6.0",
    "tesseract.js": "^6.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.18.0",
    "pdfkit": "^0.18.0",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
