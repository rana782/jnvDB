NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Default: local SQLite (no Postgres password). Optional: use PostgreSQL instead — see docs/DATABASE_PROVIDERS.md
DATABASE_URL=file:./dev.db
# Parent folder of jnv-platform/ (e.g. learn_git) so API finds jnv-platform/tools/pmshri-crawler/data/pdfs
JNV_DATA_ROOT=
JWT_SECRET=dev-jwt-secret-change-me-32chars
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Optional seed overrides (prisma db seed)
SEED_FOUNDER_ROLLCODE=founder
SEED_FOUNDER_PASSWORD=change-me-in-prod
