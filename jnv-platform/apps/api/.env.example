NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Production (Supabase direct connection; server-side only, never expose to client):
DATABASE_URL="postgresql://postgres:<YOUR_PASSWORD>@db.kbtygygxrvfbvumwcctd.supabase.co:5432/postgres?sslmode=require"
# Local fallback (optional): DATABASE_URL=file:./dev.db
# Parent folder of jnv-platform/ (e.g. learn_git) so API finds jnv-platform/tools/pmshri-crawler/data/pdfs
JNV_DATA_ROOT=
JWT_SECRET=dev-jwt-secret-change-me-32chars
# Comma-separated browser origins allowed to call the API with credentials (include your Vercel URL in production).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set true in production (HTTPS) so the auth cookie is sent securely.
COOKIE_SECURE=false

# Production: set true so POST /api/import/run is rejected. Load schools from
# jnv_pipeline/import_json_to_postgres.py (Postgres, static JSON) or import_master_to_dev_db.py (local SQLite),
# then run: npm run dev:reconcile-dashboard -w @jnv/api
JNV_DISABLE_PDF_IMPORT=true

# Optional: dashboard reconcile progress (schools per log line). 0 = quiet ticks only at phase boundaries.
# JNV_RECONCILE_PROGRESS_EVERY=50

# Optional seed overrides (prisma db seed). GitHub Actions: use SEED_ADMIN_* secrets.
SEED_ADMIN_ROLLCODE=founder
SEED_ADMIN_PASSWORD=change-me-in-prod
# Legacy aliases (same as SEED_ADMIN_*)
SEED_FOUNDER_ROLLCODE=founder
SEED_FOUNDER_PASSWORD=change-me-in-prod
